# Copy to .env and fill in. Never commit .env.
# Test-network wallets only. Never reuse a mainnet wallet here.

# Chain
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
ETHERSCAN_API_KEY=

# Role wallets (Sepolia test ETH only)
DEPLOYER_ADDRESS=
DEPLOYER_PRIVATE_KEY=
ASSESSOR_ADDRESS=
ASSESSOR_PRIVATE_KEY=
OPERATOR_ADDRESS=
OPERATOR_PRIVATE_KEY=
AUDITOR_ADDRESS=
AUDITOR_PRIVATE_KEY=

# Auditor vault keys (PyNaCl SealedBox, base64) - generated later
AUDITOR_BOX_PUBLIC_KEY=
AUDITOR_BOX_PRIVATE_KEY=

# AI (OpenAI-compatible endpoint)
AI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=deepseek/deepseek-v4.1-flash
DECISION_MODEL=typesafe/jev-1.13
DECISION_URL=https://openrouter.ai/api/alpha/decisions
OPENROUTER_API_KEY=

# API role tokens (demo) - generated by scripts/gen_api_tokens.py
OPERATOR_API_TOKEN=
AUDITOR_API_TOKEN=
ASSESSOR_API_TOKEN=
