pragma solidity ^0.8.24;

import {Test} from "forge-std/Test.sol";
import {RetirementRegistry} from "../src/RetirementRegistry.sol";

/// Shared test vectors with the Python privacy module (tests/vectors.json, generated by
/// scripts/gen_vectors.py). Both sides recompute every value, so any encoding drift fails CI.
contract VectorsTest is Test {
    RetirementRegistry internal reg;
    string internal json;

    function setUp() public {
        reg = new RetirementRegistry(0, address(this));
        json = vm.readFile(string.concat(vm.projectRoot(), "/../tests/vectors.json"));
    }

    function _key(string memory list, uint256 i, string memory field) internal pure returns (string memory) {
        return string.concat(".", list, "[", vm.toString(i), "].", field);
    }

    function test_TextIdsMatchPython() public view {
        for (uint256 i = 0; i < 4; ++i) {
            string memory text = vm.parseJsonString(json, _key("text_ids", i, "text"));
            bytes32 id = vm.parseJsonBytes32(json, _key("text_ids", i, "id"));
            assertEq(keccak256(bytes(text)), id, text);
        }
    }

    function test_CommitmentsMatchPython() public view {
        uint256 n = vm.parseJsonUint(json, ".commitment_count");
        assertGt(n, 0);
        for (uint256 i = 0; i < n; ++i) {
            string memory lei = vm.parseJsonString(json, _key("commitments", i, "lei"));
            string memory batchKey = vm.parseJsonString(json, _key("commitments", i, "batch_key"));
            bytes32 buyerId = vm.parseJsonBytes32(json, _key("commitments", i, "buyer_id"));
            bytes32 batchId = vm.parseJsonBytes32(json, _key("commitments", i, "batch_id"));
            bytes32 salt = vm.parseJsonBytes32(json, _key("commitments", i, "salt"));
            uint64 start = uint64(vm.parseJsonUint(json, _key("commitments", i, "start")));
            uint64 end = uint64(vm.parseJsonUint(json, _key("commitments", i, "end")));
            bytes32 expected = vm.parseJsonBytes32(json, _key("commitments", i, "commitment"));

            assertEq(keccak256(bytes(string.concat("LEI:", lei))), buyerId, "buyer id");
            assertEq(keccak256(bytes(batchKey)), batchId, "batch id");
            assertEq(reg.commitmentOf(buyerId, salt, batchId, start, end), expected, "commitment");
        }
    }

    /// End to end with a vector: retire with the Python commitment, then disclose and verify on-chain.
    function test_PythonCommitmentVerifiesOnChain() public {
        bytes32 buyerId = vm.parseJsonBytes32(json, ".commitments[1].buyer_id");
        bytes32 batchId = vm.parseJsonBytes32(json, ".commitments[1].batch_id");
        bytes32 salt = vm.parseJsonBytes32(json, ".commitments[1].salt");
        uint64 start = uint64(vm.parseJsonUint(json, ".commitments[1].start"));
        uint64 end = uint64(vm.parseJsonUint(json, ".commitments[1].end"));
        bytes32 c = vm.parseJsonBytes32(json, ".commitments[1].commitment");

        reg.grantRole(reg.OPERATOR_ROLE(), address(this));
        reg.registerBatch(batchId, keccak256("VCS1851"), start, end, 0);
        uint256 id = reg.retire(batchId, start, end, c, keccak256("vault"), 0);
        assertTrue(reg.verifyClaim(id, buyerId, salt));
        assertFalse(reg.verifyClaim(id, buyerId, bytes32(uint256(salt) ^ 1)));
    }
}
